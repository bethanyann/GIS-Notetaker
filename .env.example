# ── Discord ────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=                # Bot → Reset Token
DISCORD_CLIENT_ID=            # General Information → Application ID
# Optional: your server's ID. Registers /notes to just this server, instantly.
# Leave blank to register globally (takes up to an hour to show up).
DISCORD_GUILD_ID=

# ── Speech-to-text ─────────────────────────────────────────────────────────
# Any OpenAI-compatible transcription API. Default: OpenAI gpt-transcribe ($0.0045/min).
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
# To use Groq instead, uncomment these and use a Groq API key above:
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional language hint (ISO-639-1, e.g. en). Blank = auto-detect.
TRANSCRIPTION_LANGUAGE=en

# ── Meeting notes LLM ──────────────────────────────────────────────────────
# "anthropic" for Claude, or "openai" for OpenAI / any OpenAI-compatible API
SUMMARY_PROVIDER=anthropic
SUMMARY_API_KEY=
SUMMARY_MODEL=claude-sonnet-5-5
# Only for SUMMARY_PROVIDER=openai with a non-OpenAI host (OpenRouter, Gemini, etc.)
# SUMMARY_BASE_URL=

# ── Behavior ───────────────────────────────────────────────────────────────
# Words speech-to-text tends to mishear: product, repo and teammate names, jargon.
GLOSSARY=GIS, LetsGetTechnical, GitHub, PR, Jira
# Channel ID where minutes are posted (right-click channel → Copy Channel ID).
# Blank = post in whatever channel /notes start was run from.
NOTES_CHANNEL_ID=
# Optional role ID required to start/stop notes. Blank = anyone in the voice channel.
ALLOWED_ROLE_ID=
MAX_MEETING_MINUTES=180
EMPTY_CHANNEL_GRACE_SECONDS=60
